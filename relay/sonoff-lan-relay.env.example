# Settings for sonoff-lan-relay.service. Copy to /etc/default/sonoff-lan-relay
# and set RELAY_TARGET. Plain KEY=value lines, read by systemd.

# Required: the IPv4 address of the host running sonoff-mqtt. The relay does
# not start while this is empty or not an IPv4 address.
RELAY_TARGET=

# UDP port of the receiver. Must match lan_relay listen_port in the sonoff-mqtt
# config and the firewall rule that lets the datagrams through.
RELAY_PORT=15353

# Seconds between full resends of every record, at least 5. The receiver treats
# a device address as fresh for 150 s (ENDPOINT_FRESH_SECONDS in
# src/sonoff_mqtt/lan_relay.py), which assumes a resync of 60.
RELAY_RESYNC=60
